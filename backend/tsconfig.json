{
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ES2023",

    "declaration": true,
    "removeComments": true,
    "sourceMap": true,
    "outDir": "./dist",

    "incremental": true,

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}